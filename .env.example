# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8080

# PostgreSQL local (default) o Supabase Session Pooler.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=REEMPLAZAR
DB_SSL_MODE=disable
DB_SCHEMA=crud_usuarios
LOCAL_DB_PASSWORD=REEMPLAZAR_SOLO_PARA_DOCKER_COMPOSE

# Generar con: python scripts/generate_jwt_secret.py
JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO
JWT_EXPIRATION_SECONDS=900

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REEMPLAZAR

# console o smtp
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Usuarios

# Brevo (Guía 5): activa EMAIL_PROVIDER=brevo después de verificar el remitente.
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=Gestion de Usuarios
BREVO_CONNECT_TIMEOUT=2
BREVO_READ_TIMEOUT=5
BREVO_RETRY_MAX_ATTEMPTS=3
BREVO_RETRY_INITIAL_DELAY=0.5
BREVO_RETRY_MULTIPLIER=2.0
BREVO_CIRCUIT_FAILURE_THRESHOLD=50
BREVO_CIRCUIT_WINDOW_SIZE=10
BREVO_CIRCUIT_MINIMUM_CALLS=5
BREVO_CIRCUIT_OPEN_DURATION=30
