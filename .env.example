# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8080

# PostgreSQL local (default) o Supabase Session Pooler.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=REEMPLAZAR
DB_SSL_MODE=disable
DB_SCHEMA=crud_usuarios

# Generar con: python scripts/generate_jwt_secret.py
JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO
JWT_EXPIRATION_SECONDS=900

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REEMPLAZAR

# console o smtp
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Usuarios
